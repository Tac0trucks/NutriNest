<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.nutrinest"> <!-- Ensure this matches your package name -->

    <application
        android:name=".app.NutriNestApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NutriNest">

        <!-- 1. ENTRY POINT (LoginActivity starts first) -->
        <activity
            android:name=".screens.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. THE NAVIGATION HUB (Check this path!) -->
        <!-- Change to ".screens.main.MainActivity" if it's in the main folder -->
        <activity android:name=".screens.main.MainActivity" />

        <!-- 3. ALL FEATURE SLICES -->
        <activity android:name=".screens.registration.RegisterActivity" />
        <activity android:name=".screens.registration.health.HealthInfoActivity" />
        <activity android:name=".screens.registration.goals.GoalsActivity" />

    </application>
</manifest>